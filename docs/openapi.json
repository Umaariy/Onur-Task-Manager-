  "/actions":{"post":{"tags":["Workspace"],"summary":"Apply an authorized atomic mutation","description":"Actions: workspace.create(name), workspace.save(name,description), profile.save(name), card.create(CardFields+boardId), card.save(CardFields+id), card.move(id,columnId), card.archive(id,archived), card.delete(id), cards.bulk(ids,columnId|archive), card.acl(id,private,locked,allowed,acl), comment.add(id,text), comment.delete(id,commentId), board.create(name,description,template?), board.save(BoardSettings), board.copy(id,withCards), column.save(boardId,id?,name,limit,locked,color,addRoles,moveRoles), column.reorder(boardId,id,direction:-1|1), column.delete(boardId,id), member.create(name,email,password,role,boardRole,team), member.password.set(id,password), member.sessions.revoke(id), member.invite(name,email,role,team), member.save(id,name?,role,boardRole?,active,team), role.save(id?,name,nameCyrl,nameRu,permissions), notifications.read(). No direct state replacement. Internal file.add is forbidden here.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["workspaceId","version","action","payload"],"properties":{"workspaceId":{"type":"string"},"version":{"type":"integer","minimum":0},"action":{"type":"string"},"payload":{"type":"object"}}}}}},"responses":{"200":{"description":"Updated authorized workspace snapshot; member creation returns a prefilled login inviteUrl; email is not automatically sent. Legacy invitation creation returns a token inviteUrl"},"400":{"$ref":"#/components/responses/Invalid"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"409":{"description":"VERSION_CONFLICT, WIP_LIMIT or dependency/structural conflict. Refresh and review before retrying."},"429":{"description":"120 writes per identity per minute"}}}},
