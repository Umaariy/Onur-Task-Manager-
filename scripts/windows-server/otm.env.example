# ONUR Task Manager - server settings
# Copy to D:\OnurTasks\otm.env (one folder above the app) and edit.

# Public address (used for links and security checks)
OTM_PUBLIC_URL=https://tasks.onur.uz

# Internal port. Caddy forwards https://tasks.onur.uz -> 127.0.0.1:5181
PORT=5181
HOSTNAME=127.0.0.1

# Running behind Caddy: trust X-Forwarded-* headers from it
OTM_TRUST_PROXY=1

# Where the database, uploaded files and backups live
OTM_DATA_DIR=D:\OnurTasks\data
OTM_BACKUP_DIR=D:\OnurTasks\backups
OTM_BACKUP_KEEP_DAYS=30

# Setup key for the first Owner. Leave empty: it is generated once into
# D:\OnurTasks\data\setup-key.txt
OTM_SETUP_SECRET=
